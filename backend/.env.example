# Servidor
PORT=3000
NODE_ENV=development

# Configuración de CORS y Frontend
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Base de Datos NoSQL 100% MongoDB (MongoDB Atlas recomendado)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=CaseStudioAI
MONGODB_DB_NAME=case_studio_ai
MONGODB_AUTO_INDEX=true
MONGODB_TIMEOUT_MS=10000

# Seguridad JWT
JWT_SECRET=tu_secreto_super_seguro_jwt_2026
JWT_EXPIRES_IN=7d

# Proveedor de Inteligencia Artificial ('ollama' Local-First / Colab ngrok, 'vertex' respaldo Cloud Gemini)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_MS=120000

# Proveedor Cloud de Respaldo / Multimodal (Google Cloud Vertex AI / Gemini)
GCP_PROJECT_ID=tu_gcp_project_id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=tu_gemini_api_key

# Almacenamiento Cloud Amazon S3 (Artefactos y Descargas ZIP)
AWS_REGION=us-east-1
AWS_S3_ARTIFACTS_BUCKET=uml-studio-artifacts-storage
AWS_ACCESS_KEY_ID=tu_access_key_opcional_si_usas_iam_role
AWS_SECRET_ACCESS_KEY=tu_secret_key_opcional_si_usas_iam_role
AWS_S3_PRESIGNED_EXPIRATION=3600
