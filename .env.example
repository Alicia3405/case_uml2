# CASE Studio AI - Environment Configuration (MongoDB NoSQL + Local-First AI)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=CaseStudioAI
MONGODB_DB_NAME=case_studio_ai

JWT_SECRET=super_secret_case_studio_jwt_token_key_change_in_production_256bit
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
GEMINI_API_KEY=your_gemini_api_key_here
DOMAIN_NAME=localhost
